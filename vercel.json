{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/veo.js": { "maxDuration": 60 },
    "api/gemini.js": { "maxDuration": 30 },
    "api/finalize.js": {
      "maxDuration": 60,
      "includeFiles": ["node_modules/ffmpeg-static/**", "public/click.mp3"]
    }
  }
}
